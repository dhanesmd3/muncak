# Salin jadi .env lalu isi. Jangan commit .env.
# Tanggal rilis (hari rilis = #1), format YYYY-MM-DD.
VITE_LAUNCH_DATE=2026-12-01
# Kunci obfuscation ringan untuk payload harian. Ini BUKAN keamanan.
VITE_PAYLOAD_KEY=ganti-dengan-string-acak

# Fase 2: aktifkan backend (Worker). Kosongkan untuk mode statis fase 1.
# Tulis di file ini, jangan sebagai variabel shell di Git Bash: Git Bash mengubah
# "/api/v1" jadi "C:/Program Files/Git/api/v1".
# VITE_API_BASE=/api/v1

# Untuk scripts/compute-rarity.ts (bukan untuk browser):
# MUNCAK_API_URL=https://[ISI: domain]/api/v1
# MUNCAK_ADMIN_TOKEN=token-admin

# Secret Worker diisi lewat `npx wrangler@4 secret put` (DEVICE_SECRET, ADMIN_TOKEN),
# atau worker/.dev.vars untuk lokal. Jangan ditulis di sini.
