{
  "name": "muncak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixture": "tsx scripts/build-daily.ts --fixture && tsx scripts/build-bank.ts --fixture && vite",
    "build": "tsx scripts/build-daily.ts && tsx scripts/build-bank.ts && vite build",
    "build-daily": "tsx scripts/build-daily.ts",
    "build-bank": "tsx scripts/build-bank.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "validate:content": "tsx scripts/validate-content.ts",
    "plan:schedule": "tsx scripts/plan-schedule.ts",
    "compute:rarity": "tsx scripts/compute-rarity.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "worker:content": "tsx scripts/build-worker-content.ts",
    "worker:dev": "tsx scripts/build-worker-content.ts --fixture && cd worker && npx wrangler@4 d1 migrations apply muncak --local && npx wrangler@4 dev --port 8787",
    "worker:migrate": "cd worker && npx wrangler@4 d1 migrations apply muncak --remote",
    "worker:deploy": "tsx scripts/build-worker-content.ts && cd worker && npx wrangler@4 deploy"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "zod": "^4.6.7"
  }
}
